# Copy to .env. Never commit .env.

# Required for speech-to-text, voice cloning and speech output.
ELEVENLABS_API_KEY=
# A voice from your ElevenLabs library, used until someone clones their own.
DEFAULT_VOICE_ID=

# Sentence model:
#   "google"  hosted Gemma 4 through the Gemini API (photos and fragments go to Google)
#   "ollama"  Gemma 4 on this computer (nothing leaves it, needs a fast machine)
#   "lovable" Lovable AI Gateway (photos and fragments go to Lovable)
LLM_PROVIDER=google
# Only needed for LLM_PROVIDER=google, from Google AI Studio.
GEMINI_API_KEY=
# Only needed for LLM_PROVIDER=lovable.
LOVABLE_API_KEY=
# Defaults: gemma-4-26b-a4b-it (google), gemma4:e2b (ollama).
# LLM_MODEL=

# Optional overrides.
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2
# Use HOST=0.0.0.0 to reach the server from a phone.
# HOST=127.0.0.1
# PORT=3000
