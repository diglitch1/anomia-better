# Copy to .env. Never commit .env.

# Required for speech-to-text, voice cloning and speech output.
ELEVENLABS_API_KEY=
# A voice from your ElevenLabs library, used until someone clones their own.
DEFAULT_VOICE_ID=

# Sentence model: "ollama" runs Gemma 4 on this computer (nothing leaves it),
# "lovable" uses the Lovable AI Gateway (photos and fragments leave the device).
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:e2b
# Only needed for LLM_PROVIDER=lovable.
LOVABLE_API_KEY=

# Optional overrides.
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2
# Use HOST=0.0.0.0 to reach the server from a phone.
# HOST=127.0.0.1
# PORT=3000
